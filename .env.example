# ── Vagou — environment variables ──────────────────────────────────────────────
# Copy to .env.local. Never commit real secrets.

# Public base URL (metadata, sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server secret (reserved for signed tokens). REQUIRED in production.
# Generate with: openssl rand -base64 32
APP_SECRET=change-me-in-production

# Database. Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in .data/pglite
# (local development only; single process). Production REQUIRES a real PostgreSQL (Neon/Supabase/…).
# POSTGRES_URL is accepted as an alternative name.
# DATABASE_URL=postgres://user:password@host:5432/vagou?sslmode=require
DATABASE_URL=
# DATABASE_POOL_SIZE=5
# PGLITE_DATA_DIR=.data/pglite

# File storage: "database" (default when DATABASE_URL is set) or "local" (disk, default otherwise)
# STORAGE_DRIVER=
# UPLOADS_DIR=.data/uploads

# Integrations (V1 uses demo adapters; real ones are prepared in the architecture)
PLAN_ANALYZER=mock

# Demo mode: shows demo-account shortcuts on the login page and the dev password-reset link
# (never in production builds). Set false in production.
NEXT_PUBLIC_DEMO_MODE=true

# Demo data on deploy: the build seeds an EMPTY database only when ALLOW_DEMO_SEED=true.
# In production DEMO_PASSWORD is mandatory (min. 10 chars, not the development password).
# ALLOW_DEMO_SEED=true
# DEMO_PASSWORD=
